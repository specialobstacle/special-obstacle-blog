# 复制为 .env 并填入真实值。.env 不会进 git（已在 .gitignore）。

# 管理员登录密码（自定义一个足够强的密码）
ADMIN_PASSWORD=change-me-to-a-strong-password

# JWT 签名密钥：建议用 `openssl rand -hex 32` 或 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 生成
JWT_SECRET=change-me-to-a-long-random-string

# 私密内容仓库地址：文章/标签 Markdown 存在独立私密 git 仓库里，
# predev/prebuild 钩子（scripts/sync-content.mjs）会 clone 到 .content-private/。
# 例如 CONTENT_REPO_URL=https://github.com/your-name/blog-content.git
CONTENT_REPO_URL=

# 私密内容仓库的访问 token：GitHub fine-grained PAT，仅授权该仓库 Contents: Read。
# 生成入口：GitHub → Settings → Developer settings → Fine-grained personal access tokens。
# 留空时将直接用 CONTENT_REPO_URL 访问（依赖本机已配置的 SSH key / git credential）。
CONTENT_REPO_TOKEN=
