---
import type { PostEntry } from '../lib/visibility';
import {
  DOMAIN_LABELS,
  CATEGORY_LABELS,
  type Domain,
  type Category,
} from '../lib/constants';

interface Props {
  post: PostEntry;
  showAdminBadge?: boolean;
}

const { post, showAdminBadge = false } = Astro.props;
const { title, published, updated, domain, category, private: isPrivate, draft } =
  post.data;

// 「最近修改日期」：有 updated 用 updated，否则回退 published
const date = updated ?? published;
const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="group rounded-md border border-border bg-bg px-4 py-2.5 transition hover:border-primary/50">
  <div class="flex items-center gap-x-3">
    <div class="flex min-w-0 items-center gap-x-2">
      {draft && (
        <span class="shrink-0 rounded bg-amber-500/15 px-1.5 py-0.5 text-xs text-amber-600">
          草稿
        </span>
      )}
      {isPrivate && showAdminBadge && (
        <span class="shrink-0 rounded bg-rose-500/15 px-1.5 py-0.5 text-xs text-rose-500">
          私密
        </span>
      )}
      <h3 class="min-w-0 truncate text-base font-semibold">
        <a
          href={`/posts/${post.id}`}
          class="text-text transition group-hover:text-primary"
        >
          {title}
        </a>
      </h3>
    </div>

    <time datetime={date.toISOString()} class="ml-auto shrink-0 text-xs tabular-nums text-text-muted">
      {dateStr}
    </time>
  </div>

  <div class="mt-1 flex items-center gap-x-2 text-xs text-text-muted">
    <span>#{DOMAIN_LABELS[domain as Domain]}</span>
    <span>#{CATEGORY_LABELS[category as Category]}</span>
  </div>
</article>
