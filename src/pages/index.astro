---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import CardCarousel from '../components/CardCarousel.astro';
import { filterVisiblePosts, filterVisibleCards } from '../lib/visibility';

const { isAdmin } = Astro.locals;
// 首页只展示最近 5 篇可见文章 + 全部领域混合的知识卡片
const [all, cards] = await Promise.all([
  filterVisiblePosts(isAdmin),
  filterVisibleCards(isAdmin),
]);
const recent = all.slice(0, 5);
---

<BaseLayout title="Home">
  <section class="mb-10">
    <h1 class="text-3xl font-bold">你好，欢迎来到我的博客</h1>
    <p class="mt-3 text-text-muted">
      这里记录我的技术笔记、生活随笔与职场思考。
    </p>
    <div class="mt-5 flex gap-3">
      <a
        href="/posts"
        class="rounded-md bg-primary px-4 py-2 text-sm text-white transition hover:bg-primary-hover"
      >
        浏览全部文章
      </a>
      <a
        href="/about"
        class="rounded-md border border-border px-4 py-2 text-sm text-text transition hover:border-primary"
      >
        关于我
      </a>
    </div>
  </section>

  {cards.length > 0 && <CardCarousel cards={cards} />}

  <section>
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold">最近文章</h2>
      <a href="/posts" class="text-sm text-primary">查看全部 →</a>
    </div>
    <PostList
      posts={recent}
      showAdminBadges={isAdmin}
      emptyHint="还没有任何文章。"
    />
  </section>
</BaseLayout>
