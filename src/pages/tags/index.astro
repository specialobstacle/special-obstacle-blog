---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisibleTags } from '../../lib/visibility';

const { isAdmin } = Astro.locals;
const tags = await getVisibleTags(isAdmin);
---

<BaseLayout title="Tags">
  <h1 class="mb-6 text-2xl font-bold">标签</h1>

  {tags.length === 0 ? (
    <p class="py-12 text-center text-text-muted">暂无可见标签。</p>
  ) : (
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tags.map(({ tag, count }) => (
        <a
          href={`/tags/${tag.id}`}
          class="group rounded-lg border border-border bg-bg p-5 transition hover:border-primary/50"
        >
          <div class="mb-1 flex items-center gap-2">
            <h3 class="text-lg font-semibold text-text transition group-hover:text-primary">
              {tag.data.name}
            </h3>
            {tag.data.private && isAdmin && (
              <span class="rounded bg-rose-500/15 px-1.5 py-0.5 text-xs text-rose-500">
                私密
              </span>
            )}
            <span class="ml-auto rounded-full bg-surface px-2 py-0.5 text-xs text-text-muted">
              {count}
            </span>
          </div>
          {tag.data.description && (
            <p class="line-clamp-2 text-sm text-text-muted">
              {tag.data.description}
            </p>
          )}
        </a>
      ))}
    </div>
  )}
</BaseLayout>
