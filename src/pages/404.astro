---
import BaseLayout from '../layouts/BaseLayout.astro';
// SSR 渲染：BaseLayout/Header 会访问 Astro.url 与 Astro.locals，
// 预渲染会与 request.headers 冲突。SSR 下 404 体验与全站一致。
---

<BaseLayout title="404">
  <section class="py-20 text-center">
    <p class="text-5xl font-bold text-primary">404</p>
    <h1 class="mt-4 text-2xl font-semibold">页面不存在</h1>
    <p class="mt-2 text-text-muted">
      你访问的页面可能已被移除、重命名，或从未存在。
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a
        href="/"
        class="rounded-md bg-primary px-4 py-2 text-sm text-white transition hover:bg-primary-hover"
      >
        回到首页
      </a>
      <a
        href="/posts"
        class="rounded-md border border-border px-4 py-2 text-sm text-text transition hover:border-primary"
      >
        浏览文章
      </a>
    </div>
  </section>
</BaseLayout>
