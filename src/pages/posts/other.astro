---
import PostListPage from '../../components/PostListPage.astro';
import { getDomainPosts } from './_domain';

const { posts, label, notFound } = await getDomainPosts(
  'other',
  Astro.locals.isAdmin,
);
if (notFound) return Astro.redirect('/404');
---

<PostListPage
  title={`${label}文章`}
  posts={posts}
  showAdminBadges={Astro.locals.isAdmin}
  emptyHint={`${label}分类下还没有文章。`}
/>
