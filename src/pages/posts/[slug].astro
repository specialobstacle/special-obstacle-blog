---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import {
  getVisiblePost,
  type PostEntry,
} from '../../lib/visibility';
import {
  DOMAIN_LABELS,
  CATEGORY_LABELS,
  type Domain,
  type Category,
} from '../../lib/constants';

const { slug } = Astro.params;
const { isAdmin } = Astro.locals;

const post: PostEntry | null = slug
  ? await getVisiblePost(slug, isAdmin)
  : null;

// 文章不存在或对当前 viewer 不可见 → 404（绝不暴露存在性）
if (!post) {
  return Astro.redirect('/404');
}

const { Content, headings } = await render(post);
const { title, published, domain, category } = post.data;

const dateStr = published.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={post.data.excerpt}>
  <article>
    <header class="mb-8 border-b border-border pb-6">
      <div class="mb-3 flex items-center gap-2 text-xs text-text-muted">
        <span class="rounded bg-surface px-1.5 py-0.5">
          {DOMAIN_LABELS[domain as Domain]}
        </span>
        <span class="rounded bg-surface px-1.5 py-0.5">
          {CATEGORY_LABELS[category as Category]}
        </span>
        <span>·</span>
        <time datetime={published.toISOString()}>{dateStr}</time>
      </div>
      <h1 class="text-3xl font-bold leading-tight">{title}</h1>
    </header>

    <div class="grid gap-10 lg:grid-cols-[1fr_220px]">
      {/* 正文 */}
      <div class="prose min-w-0">
        <Content />
      </div>

      {/* 右侧 TOC：lg 及以上显示，小屏隐藏 */}
      <aside class="hidden lg:block">
        <Toc headings={headings} />
      </aside>
    </div>
  </article>
</BaseLayout>
